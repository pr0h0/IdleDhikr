{
  "names": [
    {
      "id": 1,
      "translation": "Milostivi",
      "transcription": "Er-Rahmān",
      "arabic": "الرَّحْمَٰنُ"
    },
    {
      "id": 2,
      "translation": "Samilosni",
      "transcription": "Er-Rahīm",
      "arabic": "الرَّحِيمُ"
    },
    {
      "id": 3,
      "translation": "Vladar",
      "transcription": "El-Melik",
      "arabic": "الْمَلِكُ"
    },
    {
      "id": 4,
      "translation": "Sveti, čist od svakog nedostatka",
      "transcription": "El-Kuddūs",
      "arabic": "الْقُدُّوسُ"
    },
    {
      "id": 5,
      "translation": "Izvor mira i spasa",
      "transcription": "Es-Selām",
      "arabic": "السَّلَامُ"
    },
    {
      "id": 6,
      "translation": "Onaj koji daje sigurnost",
      "transcription": "El-Mu'min",
      "arabic": "الْمُؤْمِنُ"
    },
    {
      "id": 7,
      "translation": "Onaj koji nad svim bdije",
      "transcription": "El-Muhejmin",
      "arabic": "الْمُهَيْمِنُ"
    },
    {
      "id": 8,
      "translation": "Silni, Nepobjedivi",
      "transcription": "El-Azīz",
      "arabic": "الْعَزِيزُ"
    },
    {
      "id": 9,
      "translation": "Onaj kome se ništa ne može oduprijeti",
      "transcription": "El-Džebbār",
      "arabic": "الْجَبَّارُ"
    },
    {
      "id": 10,
      "translation": "Onaj kome pripada sva veličina",
      "transcription": "El-Mutekebbir",
      "arabic": "الْمُتَكَبِّرُ"
    },
    {
      "id": 11,
      "translation": "Stvoritelj",
      "transcription": "El-Hālik",
      "arabic": "الْخَالِقُ"
    },
    {
      "id": 12,
      "translation": "Onaj koji iz ničega stvara",
      "transcription": "El-Bāri'",
      "arabic": "الْبَارِئُ"
    },
    {
      "id": 13,
      "translation": "Onaj koji daje oblik",
      "transcription": "El-Musavvir",
      "arabic": "الْمُصَوِّرُ"
    },
    {
      "id": 14,
      "translation": "Onaj koji mnogo prašta",
      "transcription": "El-Gaffār",
      "arabic": "الْغَفَّارُ"
    },
    {
      "id": 15,
      "translation": "Onaj koji sve nadvladava",
      "transcription": "El-Kahhār",
      "arabic": "الْقَهَّارُ"
    },
    {
      "id": 16,
      "translation": "Darovatelj",
      "transcription": "El-Vehhāb",
      "arabic": "الْوَهَّابُ"
    },
    {
      "id": 17,
      "translation": "Opskrbitelj",
      "transcription": "Er-Rezzāk",
      "arabic": "الرَّزَّاقُ"
    },
    {
      "id": 18,
      "translation": "Onaj koji otvara i rješava",
      "transcription": "El-Fettāh",
      "arabic": "الْفَتَّاحُ"
    },
    {
      "id": 19,
      "translation": "Sveznajući",
      "transcription": "El-Alīm",
      "arabic": "الْعَلِيمُ"
    },
    {
      "id": 20,
      "translation": "Onaj koji uskraćuje",
      "transcription": "El-Kābid",
      "arabic": "الْقَابِضُ"
    },
    {
      "id": 21,
      "translation": "Onaj koji obilno daje",
      "transcription": "El-Bāsit",
      "arabic": "الْبَاسِطُ"
    },
    {
      "id": 22,
      "translation": "Onaj koji spušta",
      "transcription": "El-Hāfid",
      "arabic": "الْخَافِضُ"
    },
    {
      "id": 23,
      "translation": "Onaj koji uzdiže",
      "transcription": "Er-Rāfi'",
      "arabic": "الرَّافِعُ"
    },
    {
      "id": 24,
      "translation": "Onaj koji daje čast",
      "transcription": "El-Mu'izz",
      "arabic": "الْمُعِزُّ"
    },
    {
      "id": 25,
      "translation": "Onaj koji ponižava",
      "transcription": "El-Muzill",
      "arabic": "الْمُذِلُّ"
    },
    {
      "id": 26,
      "translation": "Onaj koji sve čuje",
      "transcription": "Es-Semī'",
      "arabic": "السَّمِيعُ"
    },
    {
      "id": 27,
      "translation": "Onaj koji sve vidi",
      "transcription": "El-Basīr",
      "arabic": "الْبَصِيرُ"
    },
    {
      "id": 28,
      "translation": "Sudija",
      "transcription": "El-Hakem",
      "arabic": "الْحَكَمُ"
    },
    {
      "id": 29,
      "translation": "Pravedni",
      "transcription": "El-Adl",
      "arabic": "الْعَدْلُ"
    },
    {
      "id": 30,
      "translation": "Dobrostivi, Onaj koji zna i najskrivenije",
      "transcription": "El-Latīf",
      "arabic": "اللَّطِيفُ"
    },
    {
      "id": 31,
      "translation": "Onaj koji je o svemu obaviješten",
      "transcription": "El-Habīr",
      "arabic": "الْخَبِيرُ"
    },
    {
      "id": 32,
      "translation": "Blagi, Onaj koji ne žuri s kaznom",
      "transcription": "El-Halīm",
      "arabic": "الْحَلِيمُ"
    },
    {
      "id": 33,
      "translation": "Veličanstveni",
      "transcription": "El-Azīm",
      "arabic": "الْعَظِيمُ"
    },
    {
      "id": 34,
      "translation": "Onaj koji grijehe oprašta",
      "transcription": "El-Gafūr",
      "arabic": "الْغَفُورُ"
    },
    {
      "id": 35,
      "translation": "Onaj koji i malo djelo obilno nagrađuje",
      "transcription": "Eš-Šekūr",
      "arabic": "الشَّكُورُ"
    },
    {
      "id": 36,
      "translation": "Svevišnji",
      "transcription": "El-Alijj",
      "arabic": "الْعَلِيُّ"
    },
    {
      "id": 37,
      "translation": "Veliki",
      "transcription": "El-Kebīr",
      "arabic": "الْكَبِيرُ"
    },
    {
      "id": 38,
      "translation": "Čuvar",
      "transcription": "El-Hafīz",
      "arabic": "الْحَفِيظُ"
    },
    {
      "id": 39,
      "translation": "Onaj koji održava i hrani",
      "transcription": "El-Mukīt",
      "arabic": "الْمُقِيتُ"
    },
    {
      "id": 40,
      "translation": "Onaj koji obračunava",
      "transcription": "El-Hasīb",
      "arabic": "الْحَسِيبُ"
    },
    {
      "id": 41,
      "translation": "Uzvišeni u Svojoj veličini",
      "transcription": "El-Dželīl",
      "arabic": "الْجَلِيلُ"
    },
    {
      "id": 42,
      "translation": "Plemeniti",
      "transcription": "El-Kerīm",
      "arabic": "الْكَرِيمُ"
    },
    {
      "id": 43,
      "translation": "Onaj koji motri na sve",
      "transcription": "Er-Rakīb",
      "arabic": "الرَّقِيبُ"
    },
    {
      "id": 44,
      "translation": "Onaj koji se odaziva",
      "transcription": "El-Mudžīb",
      "arabic": "الْمُجِيبُ"
    },
    {
      "id": 45,
      "translation": "Onaj koji sve obuhvata",
      "transcription": "El-Vāsi'",
      "arabic": "الْوَاسِعُ"
    },
    {
      "id": 46,
      "translation": "Mudri",
      "transcription": "El-Hakīm",
      "arabic": "الْحَكِيمُ"
    },
    {
      "id": 47,
      "translation": "Onaj koji voli",
      "transcription": "El-Vedūd",
      "arabic": "الْوَدُودُ"
    },
    {
      "id": 48,
      "translation": "Slavni",
      "transcription": "El-Medžīd",
      "arabic": "الْمَجِيدُ"
    },
    {
      "id": 49,
      "translation": "Onaj koji proživljava",
      "transcription": "El-Bā'is",
      "arabic": "الْبَاعِثُ"
    },
    {
      "id": 50,
      "translation": "Svjedok",
      "transcription": "Eš-Šehīd",
      "arabic": "الشَّهِيدُ"
    },
    {
      "id": 51,
      "translation": "Istina",
      "transcription": "El-Hakk",
      "arabic": "الْحَقُّ"
    },
    {
      "id": 52,
      "translation": "Onaj kome se sve povjerava",
      "transcription": "El-Vekīl",
      "arabic": "الْوَكِيلُ"
    },
    {
      "id": 53,
      "translation": "Moćni",
      "transcription": "El-Kavijj",
      "arabic": "الْقَوِيُّ"
    },
    {
      "id": 54,
      "translation": "Čvrsti",
      "transcription": "El-Metīn",
      "arabic": "الْمَتِينُ"
    },
    {
      "id": 55,
      "translation": "Prijatelj i Zaštitnik",
      "transcription": "El-Velijj",
      "arabic": "الْوَلِيُّ"
    },
    {
      "id": 56,
      "translation": "Hvaljeni",
      "transcription": "El-Hamīd",
      "arabic": "الْحَمِيدُ"
    },
    {
      "id": 57,
      "translation": "Onaj koji sve zna nabrojati",
      "transcription": "El-Muhsī",
      "arabic": "الْمُحْصِي"
    },
    {
      "id": 58,
      "translation": "Onaj koji iz početka stvara",
      "transcription": "El-Mubdi'",
      "arabic": "الْمُبْدِئُ"
    },
    {
      "id": 59,
      "translation": "Onaj koji ponovo stvara",
      "transcription": "El-Mu'īd",
      "arabic": "الْمُعِيدُ"
    },
    {
      "id": 60,
      "translation": "Onaj koji daje život",
      "transcription": "El-Muhjī",
      "arabic": "الْمُحْيِي"
    },
    {
      "id": 61,
      "translation": "Onaj koji daje smrt",
      "transcription": "El-Mumīt",
      "arabic": "الْمُمِيتُ"
    },
    {
      "id": 62,
      "translation": "Živi",
      "transcription": "El-Hajj",
      "arabic": "الْحَيُّ"
    },
    {
      "id": 63,
      "translation": "Onaj koji sve održava",
      "transcription": "El-Kajjūm",
      "arabic": "الْقَيُّومُ"
    },
    {
      "id": 64,
      "translation": "Onaj koji ništa ne oskudijeva",
      "transcription": "El-Vādžid",
      "arabic": "الْوَاجِدُ"
    },
    {
      "id": 65,
      "translation": "Onaj koji je savršen u slavi",
      "transcription": "El-Mādžid",
      "arabic": "الْمَاجِدُ"
    },
    {
      "id": 66,
      "translation": "Jedan",
      "transcription": "El-Vāhid",
      "arabic": "الْوَاحِدُ"
    },
    {
      "id": 67,
      "translation": "Jedini, Neusporedivi",
      "transcription": "El-Ehad",
      "arabic": "الْأَحَدُ"
    },
    {
      "id": 68,
      "translation": "Onaj kome se svi obraćaju",
      "transcription": "Es-Samed",
      "arabic": "الصَّمَدُ"
    },
    {
      "id": 69,
      "translation": "Svemoćni",
      "transcription": "El-Kādir",
      "arabic": "الْقَادِرُ"
    },
    {
      "id": 70,
      "translation": "Onaj koji ima apsolutnu moć",
      "transcription": "El-Muktedir",
      "arabic": "الْمُقْتَدِرُ"
    },
    {
      "id": 71,
      "translation": "Onaj koji stavlja naprijed",
      "transcription": "El-Mukaddim",
      "arabic": "الْمُقَدِّمُ"
    },
    {
      "id": 72,
      "translation": "Onaj koji odgađa",
      "transcription": "El-Muahhir",
      "arabic": "الْمُؤَخِّرُ"
    },
    {
      "id": 73,
      "translation": "Prvi",
      "transcription": "El-Evvel",
      "arabic": "الْأَوَّلُ"
    },
    {
      "id": 74,
      "translation": "Posljednji",
      "transcription": "El-Āhir",
      "arabic": "الْآخِرُ"
    },
    {
      "id": 75,
      "translation": "Očiti",
      "transcription": "Ez-Zāhir",
      "arabic": "الظَّاهِرُ"
    },
    {
      "id": 76,
      "translation": "Skriveni",
      "transcription": "El-Bātin",
      "arabic": "الْبَاطِنُ"
    },
    {
      "id": 77,
      "translation": "Upravitelj",
      "transcription": "El-Vālī",
      "arabic": "الْوَالِي"
    },
    {
      "id": 78,
      "translation": "Preuzvišeni",
      "transcription": "El-Muteālī",
      "arabic": "الْمُتَعَالِي"
    },
    {
      "id": 79,
      "translation": "Dobročinitelj",
      "transcription": "El-Berr",
      "arabic": "الْبَرُّ"
    },
    {
      "id": 80,
      "translation": "Onaj koji prima pokajanje",
      "transcription": "Et-Tevvāb",
      "arabic": "التَّوَّابُ"
    },
    {
      "id": 81,
      "translation": "Onaj koji kažnjava krivce",
      "transcription": "El-Muntekim",
      "arabic": "الْمُنْتَقِمُ"
    },
    {
      "id": 82,
      "translation": "Onaj koji briše grijehe",
      "transcription": "El-Afuvv",
      "arabic": "الْعَفُوُّ"
    },
    {
      "id": 83,
      "translation": "Sažaljivi",
      "transcription": "Er-Raūf",
      "arabic": "الرَّءُوفُ"
    },
    {
      "id": 84,
      "translation": "Vlasnik svake vlasti",
      "transcription": "Māliku-l-mulk",
      "arabic": "مَالِكُ الْمُلْكِ"
    },
    {
      "id": 85,
      "translation": "Gospodar veličanstva i plemenitosti",
      "transcription": "Zu-l-dželāli ve-l-ikrām",
      "arabic": "ذُو الْجَلَالِ وَالْإِكْرَامِ"
    },
    {
      "id": 86,
      "translation": "Pravični",
      "transcription": "El-Muksit",
      "arabic": "الْمُقْسِطُ"
    },
    {
      "id": 87,
      "translation": "Onaj koji sakuplja",
      "transcription": "El-Džāmi'",
      "arabic": "الْجَامِعُ"
    },
    {
      "id": 88,
      "translation": "Neovisni, Bogati",
      "transcription": "El-Ganijj",
      "arabic": "الْغَنِيُّ"
    },
    {
      "id": 89,
      "translation": "Onaj koji obogaćuje",
      "transcription": "El-Mugnī",
      "arabic": "الْمُغْنِي"
    },
    {
      "id": 90,
      "translation": "Onaj koji sprečava",
      "transcription": "El-Māni'",
      "arabic": "الْمَانِعُ"
    },
    {
      "id": 91,
      "translation": "Onaj koji određuje štetu",
      "transcription": "Ed-Dārr",
      "arabic": "الضَّارُّ"
    },
    {
      "id": 92,
      "translation": "Onaj koji daje korist",
      "transcription": "En-Nāfi'",
      "arabic": "النَّافِعُ"
    },
    {
      "id": 93,
      "translation": "Svjetlo",
      "transcription": "En-Nūr",
      "arabic": "النُّورُ"
    },
    {
      "id": 94,
      "translation": "Onaj koji upućuje na pravi put",
      "transcription": "El-Hādī",
      "arabic": "الْهَادِي"
    },
    {
      "id": 95,
      "translation": "Onaj koji stvara bez uzora",
      "transcription": "El-Bedī'",
      "arabic": "الْبَدِيعُ"
    },
    {
      "id": 96,
      "translation": "Vječni",
      "transcription": "El-Bākī",
      "arabic": "الْبَاقِي"
    },
    {
      "id": 97,
      "translation": "Nasljednik svega",
      "transcription": "El-Vāris",
      "arabic": "الْوَارِثُ"
    },
    {
      "id": 98,
      "translation": "Onaj koji sve ispravno usmjerava",
      "transcription": "Er-Rešīd",
      "arabic": "الرَّشِيدُ"
    },
    {
      "id": 99,
      "translation": "Strpljivi",
      "transcription": "Es-Sabūr",
      "arabic": "الصَّبُورُ"
    }
  ]
